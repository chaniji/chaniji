{
  "title": "Essential Docker Commands",
  "description": "Commonly used Docker commands for container management",
  "commands": [
    {
      "command": "docker ps",
      "description": "List running containers"
    },
    {
      "command": "docker ps -a",
      "description": "List all containers (including stopped)"
    },
    {
      "command": "docker images",
      "description": "List local images"
    },
    {
      "command": "docker pull <image>",
      "description": "Pull an image from registry"
    },
    {
      "command": "docker push <image>",
      "description": "Push an image to registry"
    },
    {
      "command": "docker run <image>",
      "description": "Run a container from an image"
    },
    {
      "command": "docker run -d <image>",
      "description": "Run container in detached mode (background)"
    },
    {
      "command": "docker run -it <image>",
      "description": "Run container interactively with TTY"
    },
    {
      "command": "docker run -p 8080:80 <image>",
      "description": "Map host port 8080 to container port 80"
    },
    {
      "command": "docker run -v /host/path:/container/path <image>",
      "description": "Mount host directory into container"
    },
    {
      "command": "docker run --name mycontainer <image>",
      "description": "Assign a name to the container"
    },
    {
      "command": "docker run --rm <image>",
      "description": "Auto-remove container when it exits"
    },
    {
      "command": "docker run -e ENV_VAR=value <image>",
      "description": "Set environment variable in container"
    },
    {
      "command": "docker start <container>",
      "description": "Start a stopped container"
    },
    {
      "command": "docker stop <container>",
      "description": "Stop a running container"
    },
    {
      "command": "docker restart <container>",
      "description": "Restart a container"
    },
    {
      "command": "docker rm <container>",
      "description": "Remove a stopped container"
    },
    {
      "command": "docker rm -f <container>",
      "description": "Force remove a running container"
    },
    {
      "command": "docker rmi <image>",
      "description": "Remove an image"
    },
    {
      "command": "docker exec -it <container> /bin/bash",
      "description": "Open interactive shell in running container"
    },
    {
      "command": "docker exec -it <container> sh",
      "description": "Open interactive shell (sh) in running container"
    },
    {
      "command": "docker logs <container>",
      "description": "View container logs"
    },
    {
      "command": "docker logs -f <container>",
      "description": "Follow container logs in real time"
    },
    {
      "command": "docker logs --tail 100 <container>",
      "description": "Show last 100 log lines"
    },
    {
      "command": "docker cp <container>:/path /host/path",
      "description": "Copy file/folder from container to host"
    },
    {
      "command": "docker cp /host/path <container>:/path",
      "description": "Copy file/folder from host to container"
    },
    {
      "command": "docker build -t myimage:tag .",
      "description": "Build image from Dockerfile in current directory"
    },
    {
      "command": "docker build -f Dockerfile.dev -t myimage .",
      "description": "Build image using a specific Dockerfile"
    },
    {
      "command": "docker build --no-cache -t myimage .",
      "description": "Build image without using cache"
    },
    {
      "command": "docker commit <container> myimage:tag",
      "description": "Create image from container changes"
    },
    {
      "command": "docker tag <image> <registry>/<image>:<tag>",
      "description": "Tag an image with a new name/tag"
    },
    {
      "command": "docker login",
      "description": "Log in to Docker registry"
    },
    {
      "command": "docker login <registry-url>",
      "description": "Log in to a specific registry"
    },
    {
      "command": "docker logout",
      "description": "Log out from Docker registry"
    },
    {
      "command": "docker network ls",
      "description": "List Docker networks"
    },
    {
      "command": "docker network create mynetwork",
      "description": "Create a Docker network"
    },
    {
      "command": "docker network connect <network> <container>",
      "description": "Connect container to a network"
    },
    {
      "command": "docker network disconnect <network> <container>",
      "description": "Disconnect container from a network"
    },
    {
      "command": "docker volume ls",
      "description": "List Docker volumes"
    },
    {
      "command": "docker volume create myvolume",
      "description": "Create a Docker volume"
    },
    {
      "command": "docker volume prune",
      "description": "Remove all unused volumes"
    },
    {
      "command": "docker system df",
      "description": "Show Docker disk usage"
    },
    {
      "command": "docker system prune",
      "description": "Remove unused data (containers, networks, images)"
    },
    {
      "command": "docker system prune -a",
      "description": "Remove all unused data including dangling images"
    },
    {
      "command": "docker stats",
      "description": "Live resource usage stats for containers"
    },
    {
      "command": "docker top <container>",
      "description": "Show running processes in a container"
    },
    {
      "command": "docker inspect <container>",
      "description": "Detailed info about container (JSON)"
    },
    {
      "command": "docker inspect <image>",
      "description": "Detailed info about image (JSON)"
    },
    {
      "command": "docker history <image>",
      "description": "Show image layer history"
    },
    {
      "command": "docker info",
      "description": "Docker system information"
    },
    {
      "command": "docker version",
      "description": "Show Docker version info"
    },
    {
      "command": "docker save -o myimage.tar <image>",
      "description": "Save image to tar archive"
    },
    {
      "command": "docker load -i myimage.tar",
      "description": "Load image from tar archive"
    },
    {
      "command": "docker export -o container.tar <container>",
      "description": "Export container filesystem to tar"
    },
    {
      "command": "docker import container.tar myimage:tag",
      "description": "Import tar to create filesystem image"
    },
    {
      "command": "docker search <term>",
      "description": "Search Docker Hub for images"
    },
    {
      "command": "docker events",
      "description": "Stream Docker daemon events"
    },
    {
      "command": "docker container prune",
      "description": "Remove all stopped containers"
    },
    {
      "command": "docker image prune",
      "description": "Remove unused images"
    },
    {
      "command": "docker image ls",
      "description": "List images (alternative to docker images)"
    },
    {
      "command": "docker compose up",
      "description": "Create and start containers (docker-compose)"
    },
    {
      "command": "docker compose up -d",
      "description": "Start services in detached mode"
    },
    {
      "command": "docker compose down",
      "description": "Stop and remove containers, networks"
    },
    {
      "command": "docker compose down -v",
      "description": "Stop and remove containers, networks, volumes"
    },
    {
      "command": "docker compose ps",
      "description": "List containers in compose project"
    },
    {
      "command": "docker compose logs",
      "description": "View compose service logs"
    },
    {
      "command": "docker compose build",
      "description": "Build or rebuild compose services"
    },
    {
      "command": "docker compose pull",
      "description": "Pull service images"
    },
    {
      "command": "docker compose restart",
      "description": "Restart compose services"
    },
    {
      "command": "docker compose exec <service> <command>",
      "description": "Execute command in a running service container"
    },
    {
      "command": "docker compose -f docker-compose.prod.yml up",
      "description": "Use alternative compose file"
    }
  ]
}
