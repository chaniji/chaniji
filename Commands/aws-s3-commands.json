{
  "title": "Essential AWS S3 Commands",
  "description": "Commonly used AWS S3 CLI commands for bucket and object management",
  "commands": [
    {
      "command": "aws s3 ls",
      "description": "List all S3 buckets"
    },
    {
      "command": "aws s3 ls s3://<bucket>",
      "description": "List objects in a bucket"
    },
    {
      "command": "aws s3 ls s3://<bucket>/<prefix>",
      "description": "List objects with a prefix"
    },
    {
      "command": "aws s3 ls s3://<bucket> --recursive",
      "description": "List all objects recursively"
    },
    {
      "command": "aws s3 ls s3://<bucket> --human-readable",
      "description": "List objects with human-readable sizes"
    },
    {
      "command": "aws s3 ls s3://<bucket> --summarize",
      "description": "List objects with total count and size"
    },
    {
      "command": "aws s3 mb s3://<bucket>",
      "description": "Create a new S3 bucket"
    },
    {
      "command": "aws s3 mb s3://<bucket> --region <region>",
      "description": "Create a bucket in a specific region"
    },
    {
      "command": "aws s3 rb s3://<bucket>",
      "description": "Remove an empty S3 bucket"
    },
    {
      "command": "aws s3 rb s3://<bucket> --force",
      "description": "Force remove a bucket and all its objects"
    },
    {
      "command": "aws s3 cp <file> s3://<bucket>/",
      "description": "Upload a file to S3"
    },
    {
      "command": "aws s3 cp s3://<bucket>/<file> .",
      "description": "Download a file from S3"
    },
    {
      "command": "aws s3 cp s3://<bucket>/<file> s3://<bucket2>/<file>",
      "description": "Copy object between S3 locations"
    },
    {
      "command": "aws s3 cp <dir>/ s3://<bucket>/ --recursive",
      "description": "Upload a directory recursively"
    },
    {
      "command": "aws s3 cp s3://<bucket>/ . --recursive",
      "description": "Download an entire bucket/prefix"
    },
    {
      "command": "aws s3 cp <file> s3://<bucket>/ --acl public-read",
      "description": "Upload with public-read ACL"
    },
    {
      "command": "aws s3 cp --dryrun <file> s3://<bucket>/",
      "description": "Dry run - show what would be copied"
    },
    {
      "command": "aws s3 cp --exclude \"*.txt\" --include \"*.jpg\" <dir>/ s3://<bucket>/ --recursive",
      "description": "Upload with include/exclude filters"
    },
    {
      "command": "aws s3 mv <file> s3://<bucket>/",
      "description": "Move/upload a file (deletes local)"
    },
    {
      "command": "aws s3 mv s3://<bucket>/<file> s3://<bucket2>/<file>",
      "description": "Move object between S3 locations"
    },
    {
      "command": "aws s3 mv <dir>/ s3://<bucket>/ --recursive",
      "description": "Move directory to S3 recursively"
    },
    {
      "command": "aws s3 rm s3://<bucket>/<file>",
      "description": "Delete an object"
    },
    {
      "command": "aws s3 rm s3://<bucket>/ --recursive",
      "description": "Delete all objects under a prefix"
    },
    {
      "command": "aws s3 rm s3://<bucket>/ --recursive --exclude \"*.jpg\"",
      "description": "Delete with exclusion filter"
    },
    {
      "command": "aws s3 sync <dir>/ s3://<bucket>/",
      "description": "Sync local directory to S3 (upload new/changed)"
    },
    {
      "command": "aws s3 sync s3://<bucket>/ <dir>/",
      "description": "Sync S3 to local directory (download new/changed)"
    },
    {
      "command": "aws s3 sync s3://<bucket>/ s3://<bucket2>/",
      "description": "Sync between S3 buckets"
    },
    {
      "command": "aws s3 sync <dir>/ s3://<bucket>/ --delete",
      "description": "Sync and delete files in S3 not present locally"
    },
    {
      "command": "aws s3 sync <dir>/ s3://<bucket>/ --exclude \"*.tmp\"",
      "description": "Sync with exclusion pattern"
    },
    {
      "command": "aws s3 presign s3://<bucket>/<file>",
      "description": "Generate a presigned URL (default 3600s)"
    },
    {
      "command": "aws s3 presign s3://<bucket>/<file> --expires-in 86400",
      "description": "Generate presigned URL with custom expiration"
    },
    {
      "command": "aws s3api list-buckets",
      "description": "List all S3 buckets (with details)"
    },
    {
      "command": "aws s3api get-bucket-location --bucket <bucket>",
      "description": "Get bucket region"
    },
    {
      "command": "aws s3api get-bucket-acl --bucket <bucket>",
      "description": "Get bucket ACL"
    },
    {
      "command": "aws s3api put-bucket-acl --bucket <bucket> --acl private",
      "description": "Set bucket ACL to private"
    },
    {
      "command": "aws s3api get-bucket-policy --bucket <bucket>",
      "description": "Get bucket policy (JSON)"
    },
    {
      "command": "aws s3api put-bucket-policy --bucket <bucket> --policy file://policy.json",
      "description": "Set bucket policy from JSON file"
    },
    {
      "command": "aws s3api delete-bucket-policy --bucket <bucket>",
      "description": "Delete bucket policy"
    },
    {
      "command": "aws s3api get-bucket-versioning --bucket <bucket>",
      "description": "Get bucket versioning status"
    },
    {
      "command": "aws s3api put-bucket-versioning --bucket <bucket> --versioning-configuration Status=Enabled",
      "description": "Enable bucket versioning"
    },
    {
      "command": "aws s3api get-bucket-lifecycle-configuration --bucket <bucket>",
      "description": "Get lifecycle rules"
    },
    {
      "command": "aws s3api put-bucket-lifecycle-configuration --bucket <bucket> --lifecycle-configuration file://lifecycle.json",
      "description": "Set lifecycle rules from JSON"
    },
    {
      "command": "aws s3api get-bucket-encryption --bucket <bucket>",
      "description": "Get default encryption config"
    },
    {
      "command": "aws s3api put-bucket-encryption --bucket <bucket> --server-side-encryption-configuration file://encryption.json",
      "description": "Enable default encryption"
    },
    {
      "command": "aws s3api get-public-access-block --bucket <bucket>",
      "description": "Get public access block settings"
    },
    {
      "command": "aws s3api put-public-access-block --bucket <bucket> --public-access-block-configuration BlockPublicAcls=true,IgnorePublicAcls=true,BlockPublicPolicy=true,RestrictPublicBuckets=true",
      "description": "Block all public access"
    },
    {
      "command": "aws s3api get-bucket-cors --bucket <bucket>",
      "description": "Get CORS configuration"
    },
    {
      "command": "aws s3api put-bucket-cors --bucket <bucket> --cors-configuration file://cors.json",
      "description": "Set CORS configuration"
    },
    {
      "command": "aws s3api get-bucket-website --bucket <bucket>",
      "description": "Get website hosting config"
    },
    {
      "command": "aws s3api put-bucket-website --bucket <bucket> --website-configuration file://website.json",
      "description": "Enable static website hosting"
    },
    {
      "command": "aws s3api head-object --bucket <bucket> --key <file>",
      "description": "Get object metadata (no download)"
    },
    {
      "command": "aws s3api get-object --bucket <bucket> --key <file> <local-file>",
      "description": "Download object with metadata"
    },
    {
      "command": "aws s3api put-object --bucket <bucket> --key <file> --body <local-file>",
      "description": "Upload object with metadata"
    },
    {
      "command": "aws s3api delete-object --bucket <bucket> --key <file>",
      "description": "Delete a specific object"
    },
    {
      "command": "aws s3api delete-objects --bucket <bucket> --delete file://delete.json",
      "description": "Delete multiple objects (batch)"
    },
    {
      "command": "aws s3api list-object-versions --bucket <bucket> --prefix <prefix>",
      "description": "List all versions of objects"
    },
    {
      "command": "aws s3api restore-object --bucket <bucket> --key <file> --restore-request Days=7",
      "description": "Restore object from Glacier"
    },
    {
      "command": "aws s3api put-object-tagging --bucket <bucket> --key <file> --tagging file://tags.json",
      "description": "Set tags on an object"
    },
    {
      "command": "aws s3api get-object-tagging --bucket <bucket> --key <file>",
      "description": "Get tags of an object"
    },
    {
      "command": "aws s3api copy-object --copy-source <bucket>/<file> --bucket <target-bucket> --key <target-key>",
      "description": "Copy object server-side"
    },
    {
      "command": "aws s3api put-bucket-tagging --bucket <bucket> --tagging file://tags.json",
      "description": "Set tags on a bucket"
    },
    {
      "command": "aws s3api get-bucket-tagging --bucket <bucket>",
      "description": "Get tags of a bucket"
    },
    {
      "command": "aws s3api list-multipart-uploads --bucket <bucket>",
      "description": "List in-progress multipart uploads"
    },
    {
      "command": "aws s3api abort-multipart-upload --bucket <bucket> --key <file> --upload-id <id>",
      "description": "Abort a multipart upload"
    },
    {
      "command": "aws s3api put-bucket-replication --bucket <bucket> --replication-configuration file://replication.json",
      "description": "Set cross-region replication"
    },
    {
      "command": "aws s3api get-bucket-replication --bucket <bucket>",
      "description": "Get replication configuration"
    },
    {
      "command": "aws s3api put-bucket-logging --bucket <bucket> --bucket-logging-status file://logging.json",
      "description": "Enable server access logging"
    },
    {
      "command": "aws s3api get-bucket-logging --bucket <bucket>",
      "description": "Get server access logging config"
    },
    {
      "command": "aws s3api put-bucket-notification-configuration --bucket <bucket> --notification-configuration file://notification.json",
      "description": "Set event notifications"
    },
    {
      "command": "aws s3api get-bucket-notification-configuration --bucket <bucket>",
      "description": "Get event notification config"
    },
    {
      "command": "aws s3api put-object-legal-hold --bucket <bucket> --key <file> --legal-hold Status=ON",
      "description": "Place a legal hold on an object"
    },
    {
      "command": "aws s3api put-object-retention --bucket <bucket> --key <file> --retention file://retention.json",
      "description": "Set object retention"
    },
    {
      "command": "aws s3api get-object-lock-configuration --bucket <bucket>",
      "description": "Get object lock configuration"
    },
    {
      "command": "aws s3 cp --endpoint-url https://<endpoint> s3://<bucket>/ .",
      "description": "Use with custom S3-compatible endpoints"
    },
    {
      "command": "aws s3 cp --no-sign-request s3://<bucket>/<file> .",
      "description": "Access public bucket without credentials"
    }
  ]
}
