{
  "title": "Essential Maven Commands",
  "description": "Commonly used Maven commands for Java project management",
  "commands": [
    {
      "command": "mvn clean",
      "description": "Remove the target directory (build output)"
    },
    {
      "command": "mvn compile",
      "description": "Compile source code"
    },
    {
      "command": "mvn test",
      "description": "Run tests using the surefire test framework"
    },
    {
      "command": "mvn package",
      "description": "Package the compiled code into JAR/WAR"
    },
    {
      "command": "mvn install",
      "description": "Install package into local repository (~/.m2)"
    },
    {
      "command": "mvn deploy",
      "description": "Deploy package to remote repository"
    },
    {
      "command": "mvn clean install",
      "description": "Clean and install (common build cycle)"
    },
    {
      "command": "mvn clean install -DskipTests",
      "description": "Clean install skipping tests"
    },
    {
      "command": "mvn clean install -Dmaven.test.skip=true",
      "description": "Clean install skipping test compilation & execution"
    },
    {
      "command": "mvn test -Dtest=TestClassName",
      "description": "Run a specific test class"
    },
    {
      "command": "mvn test -Dtest=TestClassName#testMethod",
      "description": "Run a specific test method"
    },
    {
      "command": "mvn validate",
      "description": "Validate project is correct and all info is available"
    },
    {
      "command": "mvn verify",
      "description": "Run integration tests and verify package validity"
    },
    {
      "command": "mvn site",
      "description": "Generate project documentation site"
    },
    {
      "command": "mvn dependency:tree",
      "description": "Display dependency tree"
    },
    {
      "command": "mvn dependency:resolve",
      "description": "Resolve project dependencies"
    },
    {
      "command": "mvn dependency:analyze",
      "description": "Analyze dependencies (unused, undeclared)"
    },
    {
      "command": "mvn versions:display-dependency-updates",
      "description": "Check for available dependency updates"
    },
    {
      "command": "mvn versions:display-plugin-updates",
      "description": "Check for available plugin updates"
    },
    {
      "command": "mvn versions:set -DnewVersion=1.0.1",
      "description": "Set project version"
    },
    {
      "command": "mvn help:effective-pom",
      "description": "Show effective POM (after inheritance/interpolation)"
    },
    {
      "command": "mvn help:describe -Dplugin=org.apache.maven.plugins:maven-compiler-plugin",
      "description": "Describe plugin details"
    },
    {
      "command": "mvn exec:java -Dexec.mainClass=\"com.example.Main\"",
      "description": "Run a Java class from the project"
    },
    {
      "command": "mvn tomcat7:run",
      "description": "Run web app in embedded Tomcat (legacy plugin)"
    },
    {
      "command": "mvn spring-boot:run",
      "description": "Run Spring Boot application"
    },
    {
      "command": "mvn quarkus:dev",
      "description": "Run Quarkus app in dev mode"
    },
    {
      "command": "mvn javadoc:javadoc",
      "description": "Generate Javadocs"
    },
    {
      "command": "mvn source:jar",
      "description": "Attach source JAR"
    },
    {
      "command": "mvn -P production",
      "description": "Activate profile named 'production'"
    },
    {
      "command": "mvn -pl module-name",
      "description": "Build only a specific module in multi-module project"
    },
    {
      "command": "mvn -am -pl module-name",
      "description": "Build module and its dependencies"
    },
    {
      "command": "mvn -o",
      "description": "Offline mode (use local repo only)"
    },
    {
      "command": "mvn -X",
      "description": "Debug/verbose output"
    },
    {
      "command": "mvn -q",
      "description": "Quiet mode (only show errors)"
    },
    {
      "command": "mvn archetype:generate",
      "description": "Generate a new project from an archetype"
    },
    {
      "command": "mvn release:prepare",
      "description": "Prepare for release (tag, bump version)"
    },
    {
      "command": "mvn release:perform",
      "description": "Perform release (checkout tag, deploy)"
    }
  ]
}
