{
  "title": "Essential Git Commands",
  "description": "Commonly used Git commands for version control",
  "commands": [
    {
      "command": "git init",
      "description": "Initialize a new Git repository"
    },
    {
      "command": "git clone <url>",
      "description": "Clone a repository from URL"
    },
    {
      "command": "git add <file>",
      "description": "Stage a file for commit"
    },
    {
      "command": "git add .",
      "description": "Stage all changes in working directory"
    },
    {
      "command": "git commit -m \"message\"",
      "description": "Commit staged changes with a message"
    },
    {
      "command": "git commit -am \"message\"",
      "description": "Stage tracked files and commit in one step"
    },
    {
      "command": "git status",
      "description": "Show working tree status"
    },
    {
      "command": "git diff",
      "description": "Show unstaged changes"
    },
    {
      "command": "git diff --staged",
      "description": "Show staged changes"
    },
    {
      "command": "git log",
      "description": "Show commit history"
    },
    {
      "command": "git log --oneline",
      "description": "Show compact commit history (one line per commit)"
    },
    {
      "command": "git log --graph --oneline --all",
      "description": "Show branch graph with compact history"
    },
    {
      "command": "git branch",
      "description": "List local branches"
    },
    {
      "command": "git branch <name>",
      "description": "Create a new branch"
    },
    {
      "command": "git checkout <branch>",
      "description": "Switch to a branch"
    },
    {
      "command": "git checkout -b <name>",
      "description": "Create and switch to a new branch"
    },
    {
      "command": "git switch <branch>",
      "description": "Switch to a branch (alternative to checkout)"
    },
    {
      "command": "git switch -c <name>",
      "description": "Create and switch to a new branch"
    },
    {
      "command": "git merge <branch>",
      "description": "Merge a branch into the current branch"
    },
    {
      "command": "git rebase <branch>",
      "description": "Rebase current branch onto another"
    },
    {
      "command": "git rebase -i HEAD~<n>",
      "description": "Interactive rebase of last n commits"
    },
    {
      "command": "git stash",
      "description": "Stash working directory changes"
    },
    {
      "command": "git stash pop",
      "description": "Apply and remove latest stash"
    },
    {
      "command": "git stash list",
      "description": "List all stashes"
    },
    {
      "command": "git stash apply stash@{<n>}",
      "description": "Apply a specific stash without removing it"
    },
    {
      "command": "git remote -v",
      "description": "List remote repositories"
    },
    {
      "command": "git remote add origin <url>",
      "description": "Add a remote repository"
    },
    {
      "command": "git fetch",
      "description": "Download objects and refs from remote"
    },
    {
      "command": "git fetch --prune",
      "description": "Fetch and remove stale remote tracking branches"
    },
    {
      "command": "git pull",
      "description": "Fetch and merge from remote"
    },
    {
      "command": "git pull --rebase",
      "description": "Fetch and rebase onto remote branch"
    },
    {
      "command": "git push",
      "description": "Push commits to remote"
    },
    {
      "command": "git push -u origin <branch>",
      "description": "Push and set upstream tracking"
    },
    {
      "command": "git push --force-with-lease",
      "description": "Force push safely (safer than --force)"
    },
    {
      "command": "git push origin --delete <branch>",
      "description": "Delete a remote branch"
    },
    {
      "command": "git tag <name>",
      "description": "Create a lightweight tag"
    },
    {
      "command": "git tag -a <name> -m \"message\"",
      "description": "Create an annotated tag"
    },
    {
      "command": "git push origin --tags",
      "description": "Push all tags to remote"
    },
    {
      "command": "git reset HEAD~<n>",
      "description": "Undo last n commits (keep changes staged)"
    },
    {
      "command": "git reset --soft HEAD~<n>",
      "description": "Undo last n commits (keep changes staged)"
    },
    {
      "command": "git reset --mixed HEAD~<n>",
      "description": "Undo last n commits (keep changes in working dir)"
    },
    {
      "command": "git reset --hard HEAD~<n>",
      "description": "Undo last n commits (discard all changes)"
    },
    {
      "command": "git revert <commit>",
      "description": "Create a new commit that undoes a previous commit"
    },
    {
      "command": "git cherry-pick <commit>",
      "description": "Apply a specific commit from another branch"
    },
    {
      "command": "git clean -fd",
      "description": "Remove untracked files and directories"
    },
    {
      "command": "git rm <file>",
      "description": "Remove a file and stage the deletion"
    },
    {
      "command": "git mv <old> <new>",
      "description": "Rename or move a file"
    },
    {
      "command": "git blame <file>",
      "description": "Show who changed each line and when"
    },
    {
      "command": "git bisect start",
      "description": "Start binary search for a buggy commit"
    },
    {
      "command": "git bisect good/bad",
      "description": "Mark commit as good or bad during bisect"
    },
    {
      "command": "git shortlog -sn",
      "description": "Show contributor commit counts"
    },
    {
      "command": "git describe",
      "description": "Describe current commit relative to latest tag"
    },
    {
      "command": "git archive -o archive.zip HEAD",
      "description": "Create an archive of the repository"
    },
    {
      "command": "git submodule add <url> <path>",
      "description": "Add a submodule"
    },
    {
      "command": "git submodule update --init --recursive",
      "description": "Initialize and update all submodules"
    },
    {
      "command": "git config --global user.name \"Name\"",
      "description": "Set global user name"
    },
    {
      "command": "git config --global user.email \"email@example.com\"",
      "description": "Set global user email"
    },
    {
      "command": "git config --global alias.<alias> <command>",
      "description": "Create a Git alias"
    },
    {
      "command": "git reflog",
      "description": "Show reference log (recover lost commits)"
    },
    {
      "command": "git gc",
      "description": "Garbage collect and optimize repository"
    },
    {
      "command": "git fsck",
      "description": "Check repository integrity"
    },
    {
      "command": "git worktree add <path> <branch>",
      "description": "Check out a branch in a separate working tree"
    }
  ]
}
